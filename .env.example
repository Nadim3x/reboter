# AutoRepost Pipeline — environment template
#
# Copy to .env (which is gitignored) or let ./install.sh write it for you.
# Loaded by start.sh (shell) and dashboard/app.py; quote values that contain
# spaces or shell characters with single quotes, e.g. DASHBOARD_PASSWORD='p@ss w0rd'.

# --- Dashboard network --------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
# Keep this disabled unless you intentionally want to publish the dashboard.
#DASHBOARD_TUNNEL=0

# --- Dashboard login (required — without a password nobody can log in) --------
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Signs the login cookie. Generate with:  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# If unset, a random key is used per start (everyone has to log in again after a restart).
DASHBOARD_SECRET_KEY=

# --- Optional ------------------------------------------------------------------
# How long a browser login stays valid (hours, default 12)
#DASHBOARD_SESSION_HOURS=12
# Set to 1 when the dashboard runs behind a reverse proxy (nginx, Caddy, Cloudflare Tunnel)
# so X-Forwarded-For / X-Forwarded-Proto are trusted for log lines and the Secure cookie flag.
#DASHBOARD_TRUST_PROXY=0
# Force the Secure flag on the login cookie (only ever served over HTTPS)
#DASHBOARD_COOKIE_SECURE=0
